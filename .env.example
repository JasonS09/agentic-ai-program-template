# Copy this file to .env and fill in only the keys you need.
# NEVER commit the real .env file.

# --- LLM Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# --- Vector / Embeddings ---
PINECONE_API_KEY=
WEAVIATE_API_KEY=
CHROMA_DB_PATH=.chroma

# --- Observability / Logging (optional) ---
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=

# --- Evaluation / Tracking ---
WANDB_API_KEY=

# --- Custom Config ---
DEFAULT_MODEL=gpt-4o-mini
MAX_TOKENS=2048
TEMPERATURE=0.7

# Add any experiment-specific flags below:
# EXPERIMENT_FLAG=
